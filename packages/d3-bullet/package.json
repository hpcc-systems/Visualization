{
    "name": "@hpcc-js/d3-bullet",
    "version": "2.0.0",
    "description": "D3 bullet chart generator",
    "type": "module",
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.umd.cjs"
        },
        "./dist/*": "./dist/*"
    },
    "browser": "./dist/index.umd.cjs",
    "types": "./types/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist/*",
        "src/*",
        "types/*",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf --glob lib* types types-3.4 dist *.tsbuildinfo .turbo",
        "bundle": "vite build",
        "gen-types": "tsc --project tsconfig.json",
        "build": "run-p gen-types bundle",
        "lint": "eslint ./src",
        "test": "vitest run"
    },
    "devDependencies": {
        "@hpcc-js/vite-plugins": "^1.4.1",
        "@types/d3-selection": "3.0.12",
        "d3-array": "3.2.4",
        "d3-axis": "3.0.0",
        "d3-scale": "4.0.2",
        "d3-selection": "3.0.0",
        "d3-timer": "3.0.1",
        "d3-transition": "3.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hpcc-systems/Visualization.git"
    },
    "author": "Gordon Smith <gordonjsmith@gmail.com>",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/hpcc-systems/Visualization/tree/main/packages/d3-bullet"
}