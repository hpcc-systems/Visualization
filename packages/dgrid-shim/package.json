{
    "name": "@hpcc-js/dgrid-shim",
    "version": "3.5.5",
    "description": "dgrid shim",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./dist/*": "./dist/*"
    },
    "browser": "./dist/index.js",
    "types": "./types/index.d.ts",
    "files": [
        "dist/*",
        "src/*",
        "types/*"
    ],
    "scripts": {
        "clean": "rimraf --glob types dist *.tsbuildinfo .turbo",
        "bundle": "vite build",
        "bundle-watch": "vite build --watch",
        "bundle-serve": "vite --port 5504",
        "gen-types": "tsc --project tsconfig.json",
        "gen-types-watch": "npm run gen-types -- --watch",
        "build": "run-p gen-types bundle",
        "watch": "run-p gen-types-watch bundle-watch",
        "lint": "eslint ./src",
        "lint-fix": "eslint --fix src/**/*.ts",
        "update": "npx --yes npm-check-updates -u -t minor",
        "update-major": "npx --yes npm-check-updates -u"
    },
    "devDependencies": {
        "@hpcc-js/vite-plugins": "^1.2.0",
        "@types/dojo": "1.9.49",
        "dgrid": "1.3.3",
        "dijit": "1.17.3",
        "dijit-themes": "1.17.3",
        "dojo": "1.17.3",
        "dojo-dstore": "1.2.1",
        "dojo-util": "1.17.3",
        "dojox": "1.17.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hpcc-systems/Visualization.git"
    },
    "keywords": [
        "dojo",
        "vite",
        "dgrid",
        "dstore"
    ],
    "author": "Gordon Smith",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/hpcc-systems/Visualization/issues"
    },
    "homepage": "https://github.com/hpcc-systems/Visualization#readme"
}